# ==============================================================================
# Model Backend Configuration
# ==============================================================================
# 0 -> Google AI Studio (Gemini API with API key) - Recommended for standalone runs
# 1 -> Google Cloud Vertex AI (requires gcloud auth and project setup)
GOOGLE_GENAI_USE_VERTEXAI=0

# Google AI Studio API Key (get yours at https://aistudio.google.com)
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Selection (e.g. gemini-2.5-flash, gemini-1.5-pro, gemini-2.5-pro)
MODEL=gemini-2.5-flash

# ==============================================================================
# Google Cloud Vertex AI Configuration (Optional if GOOGLE_GENAI_USE_VERTEXAI=1)
# ==============================================================================
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=us-central1
STAGING_BUCKET=your_staging_bucket_name

# ==============================================================================
# Catalog & Database Configuration
# ==============================================================================
# Use local catalog JSON (default: 1) or BigQuery (0)
USE_LOCAL_CATALOG=1
LOCAL_CATALOG_PATH=data/ikea_catalog.json

# BigQuery Dataset & Table (if USE_LOCAL_CATALOG=0)
DATASET_ID=products_data_agent
TABLE_ID=ikea_items

# ==============================================================================
# Browser & Search Tool Configuration
# ==============================================================================
# Set to 1 to disable Selenium WebDriver and use resilient HTTP/mock search
DISABLE_WEB_DRIVER=0
HEADLESS_BROWSER=1
